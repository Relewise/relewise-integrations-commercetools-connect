{
  "name": "full-sync",
  "description": "",
  "version": "1.0.0",
  "main": "build/index.js",
  "private": true,
  "engines": {
    "node": ">=24 <25"
  },
  "scripts": {
    "start": "node build/index.js",
    "gcp-build": "tsc",
    "start:dev": "concurrently -k \"tsc --watch\" \"nodemon -q build/index.js\"",
    "build": "rimraf ./build && tsc",
    "type-check": "tsc --noEmit",
    "lint": "eslint \"src/**/*.ts\" \"tests/**/*.ts\"",
    "format": "prettier --write \"**/*.{js,cjs,mjs,json,md,ts,yaml,yml}\" \"../README.md\" \"../AGENTS.md\" \"../connect.yaml\" \"../.github/**/*.yml\" \"../.agents/**/*.md\" \"../.agents/**/*.yaml\"",
    "format:check": "prettier --check \"**/*.{js,cjs,mjs,json,md,ts,yaml,yml}\" \"../README.md\" \"../AGENTS.md\" \"../connect.yaml\" \"../.github/**/*.yml\" \"../.agents/**/*.md\" \"../.agents/**/*.yaml\"",
    "test": "jest --config jest.config.cjs --coverage",
    "test:ci": "jest --config jest.config.cjs --coverage --runInBand",
    "test:watch": "jest --watch"
  },
  "author": "Relewise",
  "license": "MIT",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/node": "^24.13.3",
    "@types/supertest": "^7.2.1",
    "@types/validator": "^13.15.10",
    "@typescript-eslint/eslint-plugin": "^8.68.0",
    "@typescript-eslint/parser": "^8.68.0",
    "concurrently": "^10.0.5",
    "eslint": "^10.9.1",
    "jest": "^30.4.2",
    "nodemon": "^3.1.14",
    "prettier": "^3.9.6",
    "rimraf": "^6.1.3",
    "supertest": "^7.2.2",
    "ts-jest": "^29.4.12",
    "typescript": "^6.0.3"
  },
  "dependencies": {
    "@commercetools-backend/loggers": "^27.9.3",
    "@commercetools/platform-sdk": "^9.4.0",
    "@commercetools/sdk-client-v2": "^4.0.1",
    "@relewise/client": "^2.26.0",
    "@relewise/integrations": "^1.1.2",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "validator": "^13.15.35"
  }
}
